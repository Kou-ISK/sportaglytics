{
  "extends": null,
  "appId": "com.kouisk.sportaglytics",
  "productName": "SporTagLytics",
  "afterPack": "./scripts/macos/standard-after-pack.mjs",
  "files": [
    "build/**/*",
    "!build/**/*.map",
    "!build/**/llama/models/*.gguf",
    "!build/**/llama/models/**/*.gguf",
    "!node_modules/**/*",
    "!build/llama/**/*"
  ],
  "extraResources": [
    {
      "from": "LICENSE",
      "to": "LICENSE"
    },
    {
      "from": "THIRD_PARTY_NOTICES.md",
      "to": "THIRD_PARTY_NOTICES.md"
    },
    {
      "from": "build/licenses",
      "to": "licenses"
    },
    {
      "from": "build/electron/src/licenses/preload.json",
      "to": "licenses/preload.json"
    },
    {
      "from": "resources/event-detection-models",
      "to": "event-detection-models",
      "filter": ["**/*", "!.gitkeep"]
    }
  ],
  "compression": "maximum",
  "directories": {
    "buildResources": "public",
    "output": "dist/"
  },
  "mac": {
    "publish": null,
    "target": "dmg",
    "icon": "public/icon.icns",
    "signIgnore": [
      "event-detection-models/.*/runner/[^/]+$",
      "/SporTagLytics\\.app/Contents/Resources/native-playback/(NativeProductHost|Receiver\\.node)$"
    ],
    "extraResources": [
      {
        "from": "public/icons",
        "to": ".",
        "filter": ["stpkg.icns", "stpl.icns", "stcw.icns", "stad.icns"]
      },
      {
        "from": ".cache/media-tools/darwin-${arch}",
        "to": "media-tools",
        "filter": ["ffmpeg", "ffprobe", "build.json", "licenses/**/*"]
      },
      {
        "from": ".cache/llama/darwin-${arch}",
        "to": "llama/darwin",
        "filter": ["**/*", "!**/*.gguf"]
      }
    ],
    "category": "public.app-category.sports",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "entitlements": "public/entitlements.mac.plist",
    "entitlementsInherit": "public/entitlements.mac.inherit.plist",
    "extendInfo": {
      "NSCameraUsageDescription": "\u9078\u629e\u3057\u305f\u30ab\u30e1\u30e9\u306e\u6620\u50cf\u3092\u9332\u753b\u3057\u3001\u30e9\u30a4\u30d6\u30b3\u30fc\u30c7\u30a3\u30f3\u30b0\u306b\u4f7f\u7528\u3057\u307e\u3059\u3002",
      "NSMicrophoneUsageDescription": "\u30e9\u30a4\u30d6\u30b3\u30fc\u30c7\u30a3\u30f3\u30b0\u3067\u9078\u629e\u3057\u305f\u30ab\u30e1\u30e9\u3084\u30de\u30a4\u30af\u306e\u97f3\u58f0\u3092\u9332\u97f3\u3057\u307e\u3059\u3002",
      "NSCameraUseContinuityCameraDeviceType": true,
      "NSAudioCaptureUsageDescription": "YouTube\u3092\u542b\u3080\u8868\u793a\u4e2d\u306e\u6620\u50cf\u306e\u97f3\u58f0\u3092\u89e3\u6790\u3057\u3001\u30e6\u30fc\u30b6\u30fc\u304c\u6307\u5b9a\u3057\u305f\u540c\u671f\u4f4d\u7f6e\u3092\u5fae\u8abf\u6574\u3059\u308b\u305f\u3081\u306b\u4f7f\u7528\u3057\u307e\u3059\u3002",
      "UTExportedTypeDeclarations": [
        {
          "UTTypeIdentifier": "com.kouisk.sportaglytics.stpkg",
          "UTTypeDescription": "SporTagLytics Package",
          "UTTypeConformsTo": ["public.data", "com.apple.package"],
          "UTTypeTagSpecification": {
            "public.filename-extension": ["stpkg"]
          }
        },
        {
          "UTTypeIdentifier": "com.kouisk.sportaglytics.stpl",
          "UTTypeDescription": "SporTagLytics Playlist",
          "UTTypeConformsTo": ["public.data", "com.apple.package"],
          "UTTypeTagSpecification": {
            "public.filename-extension": ["stpl"]
          }
        },
        {
          "UTTypeIdentifier": "com.kouisk.sportaglytics.stcw",
          "UTTypeDescription": "SporTagLytics Code Window",
          "UTTypeConformsTo": ["public.data"],
          "UTTypeTagSpecification": {
            "public.filename-extension": ["stcw"]
          }
        },
        {
          "UTTypeIdentifier": "com.kouisk.sportaglytics.stad",
          "UTTypeDescription": "SporTagLytics Dashboard",
          "UTTypeConformsTo": ["public.data", "com.apple.package"],
          "UTTypeTagSpecification": {
            "public.filename-extension": ["stad"]
          }
        }
      ],
      "CFBundleDocumentTypes": [
        {
          "CFBundleTypeName": "SporTagLytics Package",
          "CFBundleTypeRole": "Editor",
          "CFBundleTypeIconFile": "stpkg.icns",
          "CFBundleTypeExtensions": ["stpkg"],
          "LSHandlerRank": "Owner",
          "LSItemContentTypes": ["com.kouisk.sportaglytics.stpkg"],
          "LSTypeIsPackage": true
        },
        {
          "CFBundleTypeName": "SporTagLytics Playlist",
          "CFBundleTypeRole": "Viewer",
          "CFBundleTypeIconFile": "stpl.icns",
          "CFBundleTypeExtensions": ["stpl"],
          "LSHandlerRank": "Owner",
          "LSItemContentTypes": ["com.kouisk.sportaglytics.stpl"],
          "LSTypeIsPackage": true
        },
        {
          "CFBundleTypeName": "SporTagLytics Code Window",
          "CFBundleTypeRole": "Viewer",
          "CFBundleTypeIconFile": "stcw.icns",
          "CFBundleTypeExtensions": ["stcw"],
          "LSHandlerRank": "Owner",
          "LSItemContentTypes": ["com.kouisk.sportaglytics.stcw"]
        },
        {
          "CFBundleTypeName": "SporTagLytics Dashboard",
          "CFBundleTypeRole": "Viewer",
          "CFBundleTypeIconFile": "stad.icns",
          "CFBundleTypeExtensions": ["stad"],
          "LSHandlerRank": "Owner",
          "LSItemContentTypes": ["com.kouisk.sportaglytics.stad"],
          "LSTypeIsPackage": true
        }
      ]
    }
  },
  "win": {
    "target": "nsis",
    "icon": "public/icon.ico",
    "fileAssociations": [
      {
        "ext": "stpkg",
        "name": "SporTagLytics Package",
        "description": "SporTagLytics \u30d1\u30c3\u30b1\u30fc\u30b8\u30d5\u30a1\u30a4\u30eb",
        "role": "Editor",
        "icon": "public/icons/stpkg.ico",
        "isPackage": true
      },
      {
        "ext": "stpl",
        "name": "SporTagLytics Playlist",
        "description": "SporTagLytics \u30d7\u30ec\u30a4\u30ea\u30b9\u30c8",
        "role": "Viewer",
        "icon": "public/icons/stpl.ico",
        "isPackage": true
      },
      {
        "ext": "stcw",
        "name": "SporTagLytics Code Window",
        "description": "SporTagLytics \u30b3\u30fc\u30c9\u30a6\u30a3\u30f3\u30c9\u30a6",
        "role": "Viewer",
        "icon": "public/icons/stcw.ico"
      },
      {
        "ext": "stad",
        "name": "SporTagLytics Dashboard",
        "description": "SporTagLytics \u30c0\u30c3\u30b7\u30e5\u30dc\u30fc\u30c9",
        "role": "Viewer",
        "icon": "public/icons/stad.ico",
        "isPackage": true
      }
    ],
    "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
    "extraResources": [
      {
        "from": ".cache/media-tools/win32-${arch}",
        "to": "media-tools",
        "filter": ["ffmpeg.exe", "ffprobe.exe", "build.json", "licenses/**/*"]
      },
      {
        "from": ".cache/llama/win32-${arch}",
        "to": "llama/win32",
        "filter": ["llama-completion.exe", "build.json", "licenses/**/*"]
      },
      {
        "from": ".cache/fonts",
        "to": "fonts",
        "filter": ["*.otf", "OFL.txt"]
      }
    ]
  },
  "nsis": {
    "include": "scripts/windows/installer.nsh",
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false
  },
  "linux": {
    "target": "AppImage",
    "icon": "public/icon.png",
    "fileAssociations": [
      {
        "ext": "stpkg",
        "name": "SporTagLytics Package",
        "description": "SporTagLytics \u30d1\u30c3\u30b1\u30fc\u30b8\u30d5\u30a1\u30a4\u30eb",
        "role": "Editor",
        "isPackage": true
      },
      {
        "ext": "stpl",
        "name": "SporTagLytics Playlist",
        "description": "SporTagLytics \u30d7\u30ec\u30a4\u30ea\u30b9\u30c8",
        "role": "Viewer",
        "isPackage": true
      },
      {
        "ext": "stcw",
        "name": "SporTagLytics Code Window",
        "description": "SporTagLytics \u30b3\u30fc\u30c9\u30a6\u30a3\u30f3\u30c9\u30a6",
        "role": "Viewer"
      },
      {
        "ext": "stad",
        "name": "SporTagLytics Dashboard",
        "description": "SporTagLytics \u30c0\u30c3\u30b7\u30e5\u30dc\u30fc\u30c9",
        "role": "Viewer",
        "isPackage": true
      }
    ],
    "artifactName": "${productName}-${version}.${ext}",
    "extraResources": [
      {
        "from": "public/llama/linux",
        "to": "llama/linux",
        "filter": ["**/*", "!**/*.gguf"]
      }
    ]
  },
  "afterSign": "./scripts/macos/native-after-sign.mjs"
}
